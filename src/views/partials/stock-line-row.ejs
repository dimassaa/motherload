<%
  // One editable line. `index` is the form position used in the field names;
  // the client-side row template passes `__INDEX__` so the module can rewrite
  // the names when it clones the row.
  const selected = components.find(
    (component) => String(component.id) === String(row.componentId ?? ''),
  );
  // An archived option is preserved only when it was submitted, so a rejected
  // post explains why the service refuses it instead of silently losing it.
  const componentLabel = (component) =>
    `${component.sku} — ${component.name}${component.isActive ? '' : ' (неактивен)'}`;
  const searchValue = selected ? componentLabel(selected) : '';
  const fieldId = (suffix) => `stock-line-${index}-${suffix}`;
  const rowErrors = (lineErrors && lineErrors[index]) || {};
  const errorAttrs = (field) =>
    rowErrors[field] ? `aria-invalid="true" aria-describedby="${fieldId(`${field}-error`)}"` : '';
%>
<tr class="table__row stock-line" data-stock-row data-row-index="<%= index %>">
  <td class="table__cell stock-line__component">
    <label class="visually-hidden" for="<%= fieldId('component') %>">
      Позиция, строка <%= index %>
    </label>
    <select
      class="form-field__select"
      id="<%= fieldId('component') %>"
      name="lines[<%= index %>][componentId]"
      data-component-select
      <%- errorAttrs('componentId') %>
    >
      <option value="">Выберите позицию</option>
      <% for (const component of components) { %>
        <option
          value="<%= component.id %>"
          <%- String(row.componentId ?? '') === String(component.id) ? 'selected' : '' %>
        >
          <%= componentLabel(component) %>
        </option>
      <% } %>
    </select>

    <div class="stock-line__search" data-component-search-wrap hidden>
      <input
        class="form-field__input"
        type="search"
        autocomplete="off"
        placeholder="Начните вводить SKU или название"
        value="<%= searchValue %>"
        role="combobox"
        aria-autocomplete="list"
        aria-expanded="false"
        aria-controls="<%= fieldId('suggestions') %>"
        aria-label="Поиск позиции, строка <%= index %>"
        <%- errorAttrs('componentId') %>
        data-component-search
      >
      <ul
        class="stock-line__suggestions"
        id="<%= fieldId('suggestions') %>"
        role="listbox"
        aria-label="Найденные позиции"
        data-component-suggestions
        hidden
      ></ul>
    </div>
    <% if (rowErrors.componentId) { %>
      <p class="form-field__error" id="<%= fieldId('componentId-error') %>">
        <%= rowErrors.componentId %>
      </p>
    <% } %>
  </td>

  <td class="table__cell stock-line__qty">
    <label class="visually-hidden" for="<%= fieldId('qty') %>">
      Количество, строка <%= index %>
    </label>
    <input
      class="form-field__input"
      id="<%= fieldId('qty') %>"
      name="lines[<%= index %>][qty]"
      type="text"
      inputmode="numeric"
      autocomplete="off"
      value="<%= row.qty ?? '' %>"
      <%- errorAttrs('qty') %>
      data-line-qty
    >
    <% if (rowErrors.qty) { %>
      <p class="form-field__error" id="<%= fieldId('qty-error') %>"><%= rowErrors.qty %></p>
    <% } %>
  </td>

  <% if (withCost) { %>
    <td class="table__cell stock-line__cost">
      <label class="visually-hidden" for="<%= fieldId('unit-cost') %>">
        Цена за единицу, строка <%= index %>
      </label>
      <input
        class="form-field__input"
        id="<%= fieldId('unit-cost') %>"
        name="lines[<%= index %>][unitCost]"
        type="text"
        inputmode="decimal"
        autocomplete="off"
        value="<%= row.unitCost ?? '' %>"
        <%- errorAttrs('unitCost') %>
        data-line-unit-cost
      >
      <% if (rowErrors.unitCost) { %>
        <p class="form-field__error" id="<%= fieldId('unitCost-error') %>">
          <%= rowErrors.unitCost %>
        </p>
      <% } %>
    </td>
    <td class="table__cell table__cell--num stock-line__total">
      <span class="stock-line__total-value" data-line-total>0,00</span>
    </td>
  <% } %>

  <td class="table__cell stock-line__actions">
    <button class="btn btn--ghost btn--sm" type="button" data-line-remove>Удалить</button>
  </td>
</tr>
