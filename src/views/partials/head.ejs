<%
  // Private pages are never indexed; the public landing stays indexable until
  // Task 6 adds canonical/OG metadata on top.
  const pageNoindex = typeof noindex === 'undefined' ? Boolean(currentUser) : noindex;
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title : 'Motherload' %></title>
<%# Fetch clients (the FIFO preview) read the double-submit token from here. %>
<% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
<meta name="csrf-token" content="<%= csrfToken %>">
<% } %>
<% if (pageNoindex) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<link
  rel="icon"
  href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='6'%20fill='%2309352e'/%3E%3Cpath%20d='M8%2024V8h4l4%208%204-8h4v16h-4V14l-4%208-4-8v10z'%20fill='%2385c093'/%3E%3C/svg%3E"
  type="image/svg+xml"
>
<link rel="stylesheet" href="/css/app.css">
