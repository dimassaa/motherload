<%
  // `pageMeta` is published by attachLocals with private-page defaults and
  // replaced wholesale by the public landing. Keeping the decisions here means
  // individual views only set a title and never repeat social/canonical markup.
  const meta = typeof pageMeta !== 'undefined' && pageMeta ? pageMeta : {};
  const pageTitle =
    typeof meta.title === 'string' && meta.title
      ? meta.title
      : typeof title !== 'undefined' && title
        ? title
        : 'Motherload';
  const pageDescription = typeof meta.description === 'string' ? meta.description : '';
  const pageCanonicalUrl = typeof meta.canonicalUrl === 'string' ? meta.canonicalUrl : '';
  const pageOgImageUrl = typeof meta.ogImageUrl === 'string' ? meta.ogImageUrl : '';
  const pageJsonLd = typeof meta.jsonLd === 'string' ? meta.jsonLd : '';
  const pageNoindex =
    typeof meta.noindex === 'boolean'
      ? meta.noindex
      : typeof noindex === 'undefined'
        ? true
        : noindex;
  const pageOpenGraph =
    meta.openGraph === true && pageDescription !== '' && pageCanonicalUrl !== '' && pageOgImageUrl !== '';
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= pageTitle %></title>
<% if (pageDescription) { %>
<meta name="description" content="<%= pageDescription %>">
<% } %>
<% if (pageCanonicalUrl) { %>
<link rel="canonical" href="<%= pageCanonicalUrl %>">
<% } %>
<% if (pageNoindex) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<% if (pageOpenGraph) { %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Motherload">
<meta property="og:locale" content="ru_BY">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDescription %>">
<meta property="og:url" content="<%= pageCanonicalUrl %>">
<meta property="og:image" content="<%= pageOgImageUrl %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Motherload — складской терминал комплектующих">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= pageTitle %>">
<meta name="twitter:description" content="<%= pageDescription %>">
<meta name="twitter:image" content="<%= pageOgImageUrl %>">
<% } %>
<% if (pageJsonLd) { %>
<script type="application/ld+json"><%- pageJsonLd %></script>
<% } %>
<%# Fetch clients (the FIFO preview) read the double-submit token from here. %>
<% if (typeof csrfToken !== 'undefined' && csrfToken) { %>
<meta name="csrf-token" content="<%= csrfToken %>">
<% } %>
<link
  rel="icon"
  href="data:image/svg+xml,%3Csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%2032%2032'%3E%3Crect%20width='32'%20height='32'%20rx='6'%20fill='%2309352e'/%3E%3Cpath%20d='M8%2024V8h4l4%208%204-8h4v16h-4V14l-4%208-4-8v10z'%20fill='%2385c093'/%3E%3C/svg%3E"
  type="image/svg+xml"
>
<link rel="stylesheet" href="/css/app.css">
