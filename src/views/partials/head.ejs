<%
  // Private pages are never indexed; the public landing stays indexable until
  // Task 6 adds canonical/OG metadata on top.
  const pageNoindex = typeof noindex === 'undefined' ? Boolean(currentUser) : noindex;
%>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof title !== 'undefined' && title ? title : 'Motherload' %></title>
<% if (pageNoindex) { %>
<meta name="robots" content="noindex, nofollow">
<% } %>
<link rel="stylesheet" href="/css/app.css">
