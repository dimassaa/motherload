<%
  // Links are filtered by role on the server. Hiding a link is a convenience,
  // not security: every route still enforces RBAC in Task 5.
  const allLinks = [
    { href: '/dashboard', label: 'Обзор', roles: ['admin', 'storekeeper', 'analyst'] },
    { href: '/components', label: 'Комплектующие', roles: ['admin', 'storekeeper', 'analyst'] },
    // ABC is the analytics entry point for every role; XYZ is reached from the
    // ABC page. `activePrefix` keeps the tab marked while reading XYZ too.
    {
      href: '/analytics/abc',
      label: 'Аналитика',
      roles: ['admin', 'storekeeper', 'analyst'],
      activePrefix: '/analytics',
    },
    // Stock documents are admin/storekeeper only; analysts keep the catalog
    // link instead of a stock link that would immediately answer 403.
    { href: '/stock', label: 'Остатки', roles: ['admin', 'storekeeper'] },
    { href: '/inventory', label: 'Инвентаризация', roles: ['admin', 'storekeeper'] },
    // Alerts are read by every role; the badge is the unresolved count computed
    // in locals.js for authenticated users only. Reports stay hidden until their
    // route lands: a navigation link must never advertise a 404.
    {
      href: '/alerts',
      label: 'Алерты',
      roles: ['admin', 'storekeeper', 'analyst'],
      badge: typeof openAlertsCount !== 'undefined' ? openAlertsCount : 0,
    },
    { href: '/admin/users', label: 'Пользователи', roles: ['admin'] },
    { href: '/admin/directories', label: 'Справочники', roles: ['admin'] },
    { href: '/admin/components', label: 'Позиции каталога', roles: ['admin'] },
    { href: '/admin/audit', label: 'Аудит', roles: ['admin'] },
  ];

  const role = currentUser?.role;
  const links = allLinks.filter((link) => link.roles.includes(role));
  const isActive = (link) => {
    const prefix = link.activePrefix ?? link.href;
    return currentPath === prefix || currentPath.startsWith(`${prefix}/`);
  };

  const listClass = typeof navListClass !== 'undefined' ? navListClass : 'app-nav__list';
  const itemClass = typeof navItemClass !== 'undefined' ? navItemClass : 'app-nav__item';
  const linkClass = typeof navLinkClass !== 'undefined' ? navLinkClass : 'app-nav__link';
%>
<ul class="<%= listClass %>">
  <% for (const link of links) { %>
    <li class="<%= itemClass %>">
      <a
        class="<%= linkClass %>"
        href="<%= link.href %>"
        <%- isActive(link) ? 'aria-current="page"' : '' %>
      >
        <%= link.label %>
        <% if (link.badge) { %>
          <span class="app-nav__badge" aria-label="Открытых алертов: <%= link.badge %>">
            <%= link.badge %>
          </span>
        <% } %>
      </a>
    </li>
  <% } %>
</ul>
