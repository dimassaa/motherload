<%
  const abcHref = queryString('/analytics/abc', {
    warehouseId: filters.warehouseId,
    categoryId: filters.categoryId,
  });
  const xyzHref = queryString('/analytics/xyz', {
    warehouseId: filters.warehouseId,
    categoryId: filters.categoryId,
  });
  const byWarehouse = filters.warehouseId !== null;
%>
<section aria-labelledby="reorder-title">
  <div class="page-header">
    <div>
      <p class="axis-label">
        <span>[ Аналитика ]</span>
        <span>Планирование закупок</span>
      </p>
      <h1 id="reorder-title" class="page-header__title">Точка заказа</h1>
      <p class="page-header__meta">
        Окно спроса: 90 дней (с <%= formatDate(window.start) %> по
        <%= formatDate(window.referenceDate) %>)
        · Позиций: <%= formatQty(rows.length) %>
      </p>
    </div>
    <div class="page-header__actions">
      <a class="btn btn--ghost btn--sm" href="<%= abcHref %>">ABC-анализ →</a>
      <a class="btn btn--ghost btn--sm" href="<%= xyzHref %>">XYZ-анализ →</a>
    </div>
  </div>

  <form
    class="filter-bar"
    method="get"
    action="/analytics/reorder"
    role="search"
    aria-label="Фильтры точки заказа"
  >
    <div class="form-field">
      <label class="form-field__label" for="reorder-warehouse">Склад</label>
      <select class="form-field__select" id="reorder-warehouse" name="warehouseId">
        <option value="" <%- filters.warehouseId === null ? 'selected' : '' %>>Все склады</option>
        <% for (const warehouse of options.warehouses) { %>
          <option
            value="<%= warehouse.id %>"
            <%- String(filters.warehouseId ?? '') === String(warehouse.id) ? 'selected' : '' %>
          >
            <%= warehouse.name %><%= warehouse.isActive ? '' : ' (неактивен)' %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="form-field">
      <label class="form-field__label" for="reorder-category">Категория</label>
      <select class="form-field__select" id="reorder-category" name="categoryId">
        <option value="" <%- filters.categoryId === null ? 'selected' : '' %>>Все категории</option>
        <% for (const category of options.categories) { %>
          <option
            value="<%= category.id %>"
            <%- String(filters.categoryId ?? '') === String(category.id) ? 'selected' : '' %>
          >
            <%= category.name %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="filter-bar__actions">
      <button class="btn btn--outline btn--sm" type="submit">Показать</button>
      <a class="btn btn--ghost btn--sm" href="/analytics/reorder">Сбросить</a>
    </div>
  </form>

  <% if (rows.length === 0) { %>
    <%- include('../../partials/empty-state', {
      title: 'Нет данных для планирования закупок',
      text: 'Для выбранных склада и категории нет ни остатков, ни движений за последние 180 дней. Измените фильтры или примите товар на склад.',
      actionHref: '/analytics/reorder',
      actionLabel: 'Сбросить фильтры',
    }) %>
  <% } else { %>
    <div class="card-stack">
      <section class="card" aria-labelledby="reorder-table-title">
        <h2 id="reorder-table-title" class="card__title">Что и сколько заказать</h2>
        <p class="card__text">
          Позиции отсортированы по срочности: сначала нулевой остаток, затем остаток ниже точки
          заказа, затем крупнейший рекомендуемый заказ.
          <% if (!byWarehouse) { %>
            Остатки, точка заказа и рекомендуемый заказ просуммированы по складам; EOQ — максимум
            по складам.
          <% } %>
        </p>

        <div class="table-wrap table-wrap--spaced">
          <table class="table">
            <thead class="table__head">
              <tr>
                <th class="table__heading" scope="col">SKU</th>
                <th class="table__heading" scope="col">Название</th>
                <% if (byWarehouse) { %>
                  <th class="table__heading" scope="col">Склад</th>
                <% } %>
                <th class="table__heading table__cell--num" scope="col">Остаток</th>
                <th class="table__heading table__cell--num" scope="col">Средний расход</th>
                <th class="table__heading table__cell--num" scope="col">Страховой запас</th>
                <th class="table__heading table__cell--num" scope="col">ROP</th>
                <th class="table__heading table__cell--num" scope="col">EOQ</th>
                <th class="table__heading table__cell--num" scope="col">Заказать</th>
                <th class="table__heading" scope="col">Статус</th>
              </tr>
            </thead>
            <tbody>
              <% for (const row of rows) { %>
                <tr class="table__row">
                  <td class="table__cell table__cell--code"><%= row.sku %></td>
                  <td class="table__cell">
                    <a href="/components/<%= row.componentId %>"><%= row.name %></a>
                    <% if (row.lowData) { %>
                      <span
                        class="tag tag--plain"
                        title="Меньше 14 дней истории расхода: ROP взят из минимального остатка"
                      >
                        мало данных
                      </span>
                    <% } %>
                    <% if (!byWarehouse) { %>
                      <details class="table__details">
                        <summary>Склады: <%= formatQty(row.warehouseCount) %></summary>
                        <ul class="warehouse-breakdown">
                          <% for (const pair of row.warehouses) { %>
                            <li class="warehouse-breakdown__item">
                              <span class="warehouse-breakdown__name"><%= pair.warehouse.name %></span>
                              <span>
                                остаток <%= formatQty(pair.balance) %> ·
                                ROP <%= formatNumber(pair.rop, 2) %> ·
                                EOQ <%= formatNumber(pair.eoq, 2) %> ·
                                заказать <%= formatQty(pair.suggested) %>
                              </span>
                              <% if (pair.lowData) { %>
                                <span class="tag tag--plain">мало данных</span>
                              <% } %>
                            </li>
                          <% } %>
                        </ul>
                      </details>
                    <% } %>
                  </td>
                  <% if (byWarehouse) { %>
                    <td class="table__cell"><%= row.warehouse.name %></td>
                  <% } %>
                  <td class="table__cell table__cell--num">
                    <%= formatQty(row.balance) %> <%= row.unit %>
                  </td>
                  <td class="table__cell table__cell--num">
                    <%= formatNumber(row.avgDaily, 3) %> <%= row.unit %>/день
                  </td>
                  <td class="table__cell table__cell--num">
                    <%= formatNumber(row.safetyStock, 2) %> <%= row.unit %>
                  </td>
                  <td class="table__cell table__cell--num"><%= formatNumber(row.rop, 2) %></td>
                  <td class="table__cell table__cell--num"><%= formatNumber(row.eoq, 2) %></td>
                  <td class="table__cell table__cell--num">
                    <strong><%= formatQty(row.suggested) %></strong> <%= row.unit %>
                  </td>
                  <td class="table__cell">
                    <%- include('../../partials/status-chip', { status: row.status }) %>
                    <% if (!byWarehouse && row.status === 'zero' && row.balance > 0) { %>
                      <span class="status-hint">
                        нет остатка на <%= formatQty(row.warehousesZero) %> из
                        <%= formatQty(row.warehouseCount) %> складов
                      </span>
                    <% } else if (!byWarehouse && row.status === 'below_rop' && row.balance >= row.rop) { %>
                      <span class="status-hint">
                        <%= formatQty(row.warehousesBelowRop) %> из
                        <%= formatQty(row.warehouseCount) %> складов ниже ROP
                      </span>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card" aria-labelledby="reorder-formulas-title">
        <details class="formula-details" open>
          <summary id="reorder-formulas-title" class="card__title">Как считается точка заказа</summary>
          <ul class="formula-list">
            <li>
              <strong>Окно спроса.</strong> 90 календарных дней с
              <%= formatDate(window.start) %> по <%= formatDate(window.referenceDate) %>.
              Дни без расхода входят нулями, поэтому средний расход не завышается.
            </li>
            <li>
              <strong>Средний дневной расход.</strong> Сумма расхода за окно, делённая
              на 90.
            </li>
            <li>
              <strong>Стандартное отклонение.</strong> Корень из средней суммы квадратов
              отклонений дневного расхода от среднего по всем 90 дням.
            </li>
            <li>
              <strong>Страховой запас.</strong> 1,645 × стандартное отклонение ×
              √(срок поставки в днях). Уровень сервиса — 95 %.
            </li>
            <li>
              <strong>ROP.</strong> Средний дневной расход × срок поставки + страховой
              запас. Срок поставки берётся у позиции, иначе у поставщика по умолчанию.
            </li>
            <li>
              <strong>EOQ.</strong> √(2 × годовой спрос × 50 BYN / (себестоимость × 0,20)).
              Годовой спрос — средний дневной расход × 365; стоимость заказа — 50 BYN,
              стоимость хранения — 20 % в год. Если себестоимость нулевая, EOQ не
              рассчитывается.
            </li>
            <li>
              <strong>Рекомендуемый заказ.</strong> EOQ, округлённый вверх, если остаток
              не выше ROP; иначе 0.
            </li>
            <li>
              <strong>Мало данных.</strong> Если с первого расхода прошло меньше 14 дней,
              статистике нельзя доверять: ROP равен минимальному остатку, а заказ
              добирает остаток до минимума. Позиция помечается «мало данных».
            </li>
            <li>
              <strong>Все склады.</strong> Остатки, ROP и рекомендуемый заказ
              суммируются по складам, где позиция хранится или двигалась за 180 дней.
              EOQ — размер одного заказа, поэтому показывается максимум, а детализация
              раскрывается в строке позиции.
            </li>
          </ul>
        </details>
      </section>
    </div>
  <% } %>
</section>
