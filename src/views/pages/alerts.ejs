<%
  // Labels are presentation metadata, not business rules: the stored type and
  // status values stay visible to the server and are never inferred here.
  const statusOptions = [
    { value: 'active', label: 'Активные' },
    { value: 'open', label: 'Открытые' },
    { value: 'acknowledged', label: 'Подтверждённые' },
    { value: 'resolved', label: 'Закрытые' },
    { value: 'all', label: 'Все' },
  ];
  const hasFilters = filters.type !== null || filters.warehouseId !== null || filters.status !== 'active';
%>
<section aria-labelledby="alerts-title">
  <div class="page-header">
    <div>
      <p class="axis-label">
        <span>[ Мониторинг ]</span>
        <span>Запасы требуют внимания</span>
      </p>
      <h1 id="alerts-title" class="page-header__title">Алерты</h1>
      <p class="page-header__meta">
        Открытых: <%= formatQty(openCount) %> · В выборке: <%= formatQty(alerts.length) %>
      </p>
    </div>
    <% if (canRecalculate) { %>
      <div class="page-header__actions">
        <form method="post" action="/alerts/recalculate">
          <%- csrfField() %>
          <button class="btn btn--outline btn--sm" type="submit">Пересчитать алерты</button>
        </form>
      </div>
    <% } %>
  </div>

  <p class="card__text">
    Алерт считается по паре «позиция + склад»: на складе есть остаток или движение за
    последние 180 дней. Склады, где позиции никогда не было, не создают ложных
    предупреждений. Пересчёт идемпотентен и не дублирует открытые алерты.
  </p>

  <form class="filter-bar" method="get" action="/alerts" role="search" aria-label="Фильтры алертов">
    <div class="form-field">
      <label class="form-field__label" for="alerts-type">Тип</label>
      <select class="form-field__select" id="alerts-type" name="type">
        <option value="all" <%- filters.type === null ? 'selected' : '' %>>Все типы</option>
        <% for (const type of Object.keys(typeLabels)) { %>
          <option value="<%= type %>" <%- filters.type === type ? 'selected' : '' %>>
            <%= typeLabels[type] %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="form-field">
      <label class="form-field__label" for="alerts-status">Статус</label>
      <select class="form-field__select" id="alerts-status" name="status">
        <% for (const option of statusOptions) { %>
          <option value="<%= option.value %>" <%- filters.status === option.value ? 'selected' : '' %>>
            <%= option.label %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="form-field">
      <label class="form-field__label" for="alerts-warehouse">Склад</label>
      <select class="form-field__select" id="alerts-warehouse" name="warehouseId">
        <option value="" <%- filters.warehouseId === null ? 'selected' : '' %>>Все склады</option>
        <% for (const warehouse of options.warehouses) { %>
          <option
            value="<%= warehouse.id %>"
            <%- String(filters.warehouseId ?? '') === String(warehouse.id) ? 'selected' : '' %>
          >
            <%= warehouse.name %><%= warehouse.isActive ? '' : ' (неактивен)' %>
          </option>
        <% } %>
      </select>
    </div>

    <div class="filter-bar__actions">
      <button class="btn btn--outline btn--sm" type="submit">Показать</button>
      <a class="btn btn--ghost btn--sm" href="/alerts">Сбросить</a>
    </div>
  </form>

  <% if (alerts.length === 0) { %>
    <%- include('../partials/empty-state', {
      title: 'Нет алертов',
      text: hasFilters
        ? 'По выбранным фильтрам ничего не найдено. Измените тип, статус или склад.'
        : 'Условий для предупреждений нет: остатки в норме. После приёмки, расхода или перемещения пересчитайте алерты.',
      actionHref: '/alerts',
      actionLabel: 'Сбросить фильтры',
    }) %>
  <% } else { %>
    <section class="card" aria-labelledby="alerts-table-title">
      <h2 id="alerts-table-title" class="card__title">Открытые условия</h2>
      <div class="table-wrap table-wrap--spaced">
        <table class="table">
          <thead class="table__head">
            <tr>
              <th class="table__heading" scope="col">Важность</th>
              <th class="table__heading" scope="col">Тип</th>
              <th class="table__heading" scope="col">Сообщение</th>
              <th class="table__heading" scope="col">Позиция</th>
              <th class="table__heading" scope="col">Склад</th>
              <th class="table__heading" scope="col">Создан</th>
              <th class="table__heading" scope="col">Статус</th>
              <th class="table__heading" scope="col">Действия</th>
            </tr>
          </thead>
          <tbody>
            <% for (const row of alerts) { %>
              <tr class="table__row">
                <td class="table__cell">
                  <%- include('../partials/status-chip', { status: row.severity }) %>
                </td>
                <td class="table__cell"><%= typeLabels[row.type] ?? row.type %></td>
                <td class="table__cell alert-message"><%= row.message %></td>
                <td class="table__cell">
                  <a href="/components/<%= row.componentId %>"><%= row.sku %></a>
                </td>
                <td class="table__cell"><%= row.warehouseName %></td>
                <td class="table__cell"><%= formatDateTime(row.createdAt) %></td>
                <td class="table__cell">
                  <%- include('../partials/status-chip', { status: row.status }) %>
                  <% if (row.acknowledgedByName) { %>
                    <span class="status-hint"><%= row.acknowledgedByName %></span>
                  <% } %>
                </td>
                <td class="table__cell">
                  <div class="alert-actions">
                    <% if (canAcknowledge && row.status === 'open') { %>
                      <form method="post" action="/alerts/<%= row.id %>/acknowledge">
                        <%- csrfField() %>
                        <button class="btn btn--outline btn--sm" type="submit">Подтвердить</button>
                      </form>
                    <% } %>
                    <% if (canResolve && row.status !== 'resolved') { %>
                      <form method="post" action="/alerts/<%= row.id %>/resolve">
                        <%- csrfField() %>
                        <button class="btn btn--ghost btn--sm" type="submit">Закрыть</button>
                      </form>
                    <% } %>
                    <% if (row.status === 'resolved') { %>
                      <span class="table__cell--muted">Закрыт <%= formatDateTime(row.resolvedAt) %></span>
                    <% } %>
                  </div>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </section>
  <% } %>
</section>
