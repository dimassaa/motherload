<%
  const emailValue = typeof email === 'string' ? email : '';
  const authError = typeof loginError === 'string' && loginError !== '' ? loginError : null;
%>
<section class="landing" aria-labelledby="landing-title">
  <div class="landing__intro">
    <p class="axis-label">
      <span>[ ЗАПАСЫ ]</span>
      <span>[ КОНТРОЛЬ ]</span>
    </p>

    <h1 id="landing-title" class="landing__title">
      Складской терминал для комплектующих
    </h1>

    <p class="landing__lead">
      Приёмка, расход по FIFO, инвентаризация и аналитика запасов — в одном рабочем месте.
    </p>

    <%# Decorative scatter: data as illustration, not information. The real
         numbers live on the dashboard after login. %>
    <figure class="landing__scatter-figure" aria-hidden="true">
      <svg
        class="landing__scatter"
        data-as-illustration
        viewBox="0 0 640 220"
        aria-hidden="true"
        focusable="false"
      >
        <g class="landing__scatter-grid">
          <line x1="32" y1="40" x2="608" y2="40" />
          <line x1="32" y1="92" x2="608" y2="92" />
          <line x1="32" y1="144" x2="608" y2="144" />
          <line x1="176" y1="20" x2="176" y2="196" />
          <line x1="320" y1="20" x2="320" y2="196" />
          <line x1="464" y1="20" x2="464" y2="196" />
        </g>
        <line class="landing__scatter-axis" x1="32" y1="20" x2="32" y2="196" />
        <line class="landing__scatter-axis" x1="32" y1="196" x2="608" y2="196" />
        <g class="landing__scatter-points">
          <circle cx="92" cy="156" r="4" />
          <circle cx="128" cy="132" r="5" />
          <circle cx="164" cy="148" r="4" />
          <circle cx="206" cy="110" r="4" />
          <circle cx="242" cy="124" r="5" />
          <circle cx="286" cy="88" r="4" />
          <circle cx="330" cy="102" r="5" />
          <circle cx="368" cy="72" r="4" />
          <circle cx="408" cy="94" r="4" />
          <circle cx="450" cy="58" r="5" />
          <circle cx="498" cy="76" r="4" />
          <circle cx="546" cy="48" r="4" />
        </g>
        <circle class="landing__scatter-point--focus" cx="450" cy="58" r="8" />
      </svg>
      <figcaption class="visually-hidden">Декоративная диаграмма рассеяния остатков</figcaption>
    </figure>

    <ul class="landing__facts">
      <li>Остатки по партиям и складам</li>
      <li>Точка заказа и тревоги по min/max</li>
      <li>ABC/XYZ и отчёты для решений</li>
    </ul>

    <details class="landing__about">
      <summary class="tag tag--plain">О системе</summary>
      <p class="landing__about-text">
        Motherload — учебный проект на Node.js, Express и PostgreSQL. Страницы собираются на
        сервере, без клиентского фреймворка. Демо-доступы перечислены в карточке входа.
      </p>
    </details>
  </div>

  <aside class="landing__auth card" aria-labelledby="landing-auth-title">
    <p class="tag">Вход</p>
    <h2 id="landing-auth-title" class="card__title">Рабочее место</h2>
    <p class="landing__auth-note">Доступ открыт сотрудникам склада после входа в систему.</p>

    <form class="form" method="post" action="/login" novalidate>
      <%- csrfField() %>

      <% if (authError) { %>
        <div class="form-errors" role="alert">
          <p class="form-errors__title" id="login-error"><%= authError %></p>
        </div>
      <% } %>

      <div class="form-field">
        <label class="form-field__label" for="login-email">Email</label>
        <input
          class="form-field__input"
          id="login-email"
          name="email"
          type="email"
          autocomplete="username"
          inputmode="email"
          required
          value="<%= emailValue %>"
          <%- authError ? 'aria-invalid="true" aria-describedby="login-error"' : '' %>
        >
      </div>

      <div class="form-field">
        <label class="form-field__label" for="login-password">Пароль</label>
        <input
          class="form-field__input"
          id="login-password"
          name="password"
          type="password"
          autocomplete="current-password"
          required
          <%- authError ? 'aria-invalid="true" aria-describedby="login-error"' : '' %>
        >
      </div>

      <button class="btn btn--primary" type="submit">Войти</button>
    </form>

    <details class="landing__auth-hint">
      <summary class="tag tag--plain">Демо-доступы</summary>
      <ul class="landing__facts">
        <li><code>admin@motherload.by</code> / <code>Admin!23456</code> — администратор</li>
        <li><code>sklad@motherload.by</code> / <code>Sklad!23456</code> — кладовщик</li>
        <li><code>analyst@motherload.by</code> / <code>Analyst!2345</code> — аналитик</li>
      </ul>
    </details>

    <p class="landing__auth-hint">Если вам нужен доступ, обратитесь к администратору системы.</p>
  </aside>
</section>
