<%
  const active = count.status === 'draft' || count.status === 'submitted';
  const isDraft = count.status === 'draft';

  // The difference is a signed integer; the sign is part of the paper trail,
  // so it is rendered explicitly instead of relying on the colour cue.
  const differenceLabel = (value) =>
    value === null || value === undefined ? '—' : value > 0 ? `+${value}` : String(value);
  const differenceClass = (value) => {
    if (value === null || value === undefined) return 'inventory-diff--none';
    if (value > 0) return 'inventory-diff--surplus';
    if (value < 0) return 'inventory-diff--shortage';
    return 'inventory-diff--none';
  };

  // A failed save re-renders with the exact strings the operator typed; a
  // pristine render uses the stored row value. An empty quantity is empty,
  // never a zero invented by the template.
  const fieldValue = (row, field) => {
    const pending = enteredValues[row.line.componentId];
    if (pending && pending[field] !== undefined) return pending[field];
    if (field === 'actualQty') {
      return row.line.actualQty === null ? '' : String(row.line.actualQty);
    }
    return row.line.comment ?? '';
  };

  const actualError = (row) => {
    const error = lineErrors[row.line.componentId]?.actualQty;
    if (error) return error;
    if (unfilledIds.has(row.line.componentId)) return 'Введите фактическое количество.';
    return null;
  };
  const commentError = (row) => lineErrors[row.line.componentId]?.comment ?? null;
%>
<section class="inventory-detail" aria-labelledby="inventory-detail-title">
  <div class="page-header inventory-screen-only">
    <div>
      <p class="page-header__meta">Инвентаризация</p>
      <h1 id="inventory-detail-title" class="page-header__title">
        <span class="table__cell--code"><%= count.number %></span>
      </h1>
    </div>
    <div class="card-actions">
      <a class="btn btn--ghost" href="/inventory">← К списку</a>
      <a class="btn btn--outline no-print" href="#inventory-act" data-inventory-print>Печать акта</a>
    </div>
  </div>

  <p class="form-field__hint inventory-screen-only">
    Без JavaScript нажмите Ctrl+P: на печать выводится только акт расхождений.
  </p>

  <div class="detail-grid inventory-meta inventory-screen-only">
    <div class="detail-item">
      <span class="detail-item__label">Склад</span>
      <span class="detail-item__value"><%= count.warehouseName %> · <%= count.warehouseCity %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Статус</span>
      <span class="detail-item__value">
        <%- include('../../partials/status-chip', { status: count.status }) %>
      </span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Начата</span>
      <span class="detail-item__value"><%= formatDateTime(count.createdAt) %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Автор</span>
      <span class="detail-item__value"><%= count.startedByName ?? '—' %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Отправлена</span>
      <span class="detail-item__value">
        <%= count.submittedAt ? formatDateTime(count.submittedAt) : '—' %>
      </span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Утверждена</span>
      <span class="detail-item__value">
        <%= count.approvedAt ? formatDateTime(count.approvedAt) : '—' %>
      </span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Утвердил</span>
      <span class="detail-item__value"><%= count.approvedByName ?? '—' %></span>
    </div>
    <div class="detail-item">
      <span class="detail-item__label">Заполнено строк</span>
      <span class="detail-item__value">
        <%= summary.enteredCount %> из <%= summary.lineCount %>
        · расхождений: <%= summary.discrepancyCount %>
      </span>
    </div>
  </div>

  <% if (count.comment) { %>
    <p class="inventory-comment inventory-screen-only">
      <span class="detail-item__label">Комментарий</span>
      <%= count.comment %>
    </p>
  <% } %>

  <% if (active) { %>
    <div class="notice notice--warning inventory-screen-only" role="note">
      <strong>Склад заморожен.</strong>
      Приёмка, расход и перемещение по этому складу недоступны до утверждения или отмены
      инвентаризации. Это защищает снимок учётных количеств от чужих движений.
    </div>
  <% } %>

  <%- include('../../partials/form-errors', { errors }) %>

  <form
    class="filter-bar inventory-filter inventory-screen-only"
    method="get"
    action="/inventory/<%= count.id %>"
    data-inventory-filter
  >
    <div class="form-field">
      <label class="form-field__label" for="inventory-q">Поиск</label>
      <input
        class="form-field__input"
        id="inventory-q"
        name="q"
        type="search"
        placeholder="Название или SKU"
        value="<%= filters.q %>"
        data-inventory-search
      >
    </div>

    <div class="form-field">
      <label class="form-field__label" for="inventory-only">Показать</label>
      <select class="form-field__select" id="inventory-only" name="only" data-inventory-only>
        <option value="all" <%- filters.only === 'all' ? 'selected' : '' %>>Все строки</option>
        <option value="discrepancy" <%- filters.only === 'discrepancy' ? 'selected' : '' %>>
          Только расхождения
        </option>
        <option value="unfilled" <%- filters.only === 'unfilled' ? 'selected' : '' %>>
          Только незаполненные
        </option>
      </select>
    </div>

    <div class="filter-bar__actions">
      <button class="btn btn--outline btn--sm" type="submit">Применить</button>
      <a class="btn btn--ghost btn--sm" href="/inventory/<%= count.id %>">Сбросить</a>
    </div>
  </form>

  <% if (rows.length === 0) { %>
    <div class="card inventory-empty inventory-screen-only">
      <p>
        <% if (summary.lineCount === 0) { %>
          На складе нет позиций с остатком или движениями за 180 дней — снимок пуст. Такую
          инвентаризацию можно отправить и утвердить: остатки она не изменит.
        <% } else { %>
          По выбранным условиям строк нет. <a href="/inventory/<%= count.id %>">Сбросить фильтры</a>.
        <% } %>
      </p>
    </div>
  <% } %>

  <% if (isDraft && summary.lineCount > 0) { %>
    <form
      class="inventory-entry inventory-screen-only"
      method="post"
      action="/inventory/<%= count.id %>/lines"
      data-inventory-entry
    >
      <%- csrfField() %>

      <% if (rows.length > 0) { %>
        <div class="table-wrap">
          <table class="table inventory-table" data-inventory-table>
            <thead class="table__head">
              <tr>
                <th class="table__heading" scope="col">SKU</th>
                <th class="table__heading" scope="col">Позиция</th>
                <th class="table__heading table__cell--num" scope="col">Учёт</th>
                <th class="table__heading" scope="col">Факт</th>
                <th class="table__heading table__cell--num" scope="col">Разница</th>
                <th class="table__heading" scope="col">Комментарий</th>
              </tr>
            </thead>
            <tbody>
              <% for (const row of rows) { %>
                <%
                  const errorActual = actualError(row);
                  const errorComment = commentError(row);
                  const difference = row.line.difference;
                %>
                <tr
                  class="table__row inventory-row"
                  data-inventory-row
                  data-sku="<%= row.line.sku %>"
                  data-name="<%= row.line.name %>"
                  data-difference="<%= difference === null ? '' : difference %>"
                  data-entered="<%= row.line.actualQty !== null %>"
                >
                  <td class="table__cell table__cell--code"><%= row.line.sku %></td>
                  <td class="table__cell"><%= row.line.name %></td>
                  <td class="table__cell table__cell--num"><%= formatQty(row.line.expectedQty) %></td>
                  <td class="table__cell inventory-table__actual">
                    <input
                      type="hidden"
                      name="lines[<%= row.formIndex %>][componentId]"
                      value="<%= row.line.componentId %>"
                    >
                    <label class="visually-hidden" for="actual-<%= row.line.componentId %>">
                      Фактическое количество: <%= row.line.sku %>
                    </label>
                    <input
                      class="form-field__input inventory-table__input"
                      id="actual-<%= row.line.componentId %>"
                      name="lines[<%= row.formIndex %>][actualQty]"
                      type="text"
                      inputmode="numeric"
                      autocomplete="off"
                      value="<%= fieldValue(row, 'actualQty') %>"
                      data-inventory-actual
                      data-expected="<%= row.line.expectedQty %>"
                      <%- errorActual ? `aria-invalid="true" aria-describedby="actual-error-${row.line.componentId}"` : '' %>
                    >
                    <% if (errorActual) { %>
                      <p class="form-field__error" id="actual-error-<%= row.line.componentId %>">
                        <%= errorActual %>
                      </p>
                    <% } %>
                  </td>
                  <td class="table__cell table__cell--num">
                    <span
                      class="inventory-diff <%= differenceClass(difference) %>"
                      data-inventory-difference
                    >
                      <%= differenceLabel(difference) %>
                    </span>
                  </td>
                  <td class="table__cell inventory-table__comment">
                    <label class="visually-hidden" for="comment-<%= row.line.componentId %>">
                      Комментарий: <%= row.line.sku %>
                    </label>
                    <input
                      class="form-field__input inventory-table__input"
                      id="comment-<%= row.line.componentId %>"
                      name="lines[<%= row.formIndex %>][comment]"
                      type="text"
                      maxlength="500"
                      autocomplete="off"
                      value="<%= fieldValue(row, 'comment') %>"
                      <%- errorComment ? `aria-invalid="true" aria-describedby="comment-error-${row.line.componentId}"` : '' %>
                    >
                    <% if (errorComment) { %>
                      <p class="form-field__error" id="comment-error-<%= row.line.componentId %>">
                        <%= errorComment %>
                      </p>
                    <% } %>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>

      <% for (const row of hiddenRows) { %>
        <input
          type="hidden"
          name="lines[<%= row.formIndex %>][componentId]"
          value="<%= row.line.componentId %>"
        >
        <input
          type="hidden"
          name="lines[<%= row.formIndex %>][actualQty]"
          value="<%= fieldValue(row, 'actualQty') %>"
        >
        <input
          type="hidden"
          name="lines[<%= row.formIndex %>][comment]"
          value="<%= fieldValue(row, 'comment') %>"
        >
      <% } %>

      <p class="form-field__hint">
        Пустое поле означает «не введено», а не ноль. Отправка на проверку потребует заполнить факт
        во всех строках. «Заполнить по учёту» и «Очистить» действуют только на видимые строки —
        снимите фильтр, чтобы обработать весь снимок.
      </p>

      <div class="form-actions">
        <button class="btn btn--primary" type="submit">Сохранить черновик</button>
        <button class="btn btn--ghost" type="button" data-inventory-fill>Заполнить по учёту</button>
        <button class="btn btn--ghost" type="button" data-inventory-clear>Очистить</button>
      </div>
    </form>
  <% } else if (rows.length > 0) { %>
    <div class="table-wrap inventory-screen-only">
      <table class="table inventory-table" data-inventory-table>
        <thead class="table__head">
          <tr>
            <th class="table__heading" scope="col">SKU</th>
            <th class="table__heading" scope="col">Позиция</th>
            <th class="table__heading table__cell--num" scope="col">Учёт</th>
            <th class="table__heading table__cell--num" scope="col">Факт</th>
            <th class="table__heading table__cell--num" scope="col">Разница</th>
            <th class="table__heading" scope="col">Комментарий</th>
          </tr>
        </thead>
        <tbody>
          <% for (const row of rows) { %>
            <tr
              class="table__row inventory-row"
              data-inventory-row
              data-sku="<%= row.line.sku %>"
              data-name="<%= row.line.name %>"
              data-difference="<%= row.line.difference === null ? '' : row.line.difference %>"
              data-entered="<%= row.line.actualQty !== null %>"
            >
              <td class="table__cell table__cell--code"><%= row.line.sku %></td>
              <td class="table__cell"><%= row.line.name %></td>
              <td class="table__cell table__cell--num"><%= formatQty(row.line.expectedQty) %></td>
              <td class="table__cell table__cell--num">
                <%= row.line.actualQty === null ? '—' : formatQty(row.line.actualQty) %>
              </td>
              <td class="table__cell table__cell--num">
                <span class="inventory-diff <%= differenceClass(row.line.difference) %>">
                  <%= differenceLabel(row.line.difference) %>
                </span>
              </td>
              <td class="table__cell"><%= row.line.comment ?? '—' %></td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>

  <p class="form-field__hint inventory-screen-only" data-inventory-filter-empty hidden>
    По выбранным условиям строк нет.
  </p>

  <% if (canEdit || canApprove || canCancel) { %>
    <div class="inventory-actions inventory-screen-only">
      <% if (canEdit) { %>
        <form
          method="post"
          action="/inventory/<%= count.id %>/submit"
          data-inventory-confirm
          data-confirm="Отправить инвентаризацию на проверку? После отправки фактические количества нельзя будет изменить."
        >
          <%- csrfField() %>
          <button class="btn btn--outline" type="submit">Отправить на проверку</button>
        </form>
      <% } %>

      <% if (canApprove) { %>
        <form
          method="post"
          action="/inventory/<%= count.id %>/approve"
          data-inventory-confirm
          data-confirm="Утвердить инвентаризацию? Остатки будут скорректированы по факту, отменить это нельзя."
        >
          <%- csrfField() %>
          <button class="btn btn--primary" type="submit">Утвердить инвентаризацию</button>
        </form>
      <% } %>

      <% if (canCancel) { %>
        <form
          method="post"
          action="/inventory/<%= count.id %>/cancel"
          data-inventory-confirm
          data-confirm="Отменить инвентаризацию? Введённый факт будет потерян, склад разморожен."
        >
          <%- csrfField() %>
          <button class="btn btn--ghost inventory-danger" type="submit">
            Отменить инвентаризацию
          </button>
        </form>
      <% } %>
    </div>
  <% } %>

  <section class="inventory-act" id="inventory-act" aria-labelledby="inventory-act-title">
    <div class="inventory-act__head">
      <h2 class="card__title" id="inventory-act-title">Акт расхождений</h2>
      <p class="inventory-act__meta">
        <%= count.number %> · <%= count.warehouseName %> · статус: <%= statusChip(count.status).label %>
      </p>
    </div>

    <p class="inventory-act__summary">
      Недостача: <%= formatQty(summary.shortageQty) %> шт. ·
      излишки: <%= formatQty(summary.surplusQty) %> шт. ·
      итоговое отклонение: <%= summary.netQty > 0 ? '+' : '' %><%= formatQty(summary.netQty) %> шт.
    </p>

    <% if (summary.enteredCount < summary.lineCount) { %>
      <p class="inventory-act__warning">
        Факт введён не по всем строкам: <%= summary.enteredCount %> из <%= summary.lineCount %>.
        Акт неполный — незаполненные позиции в него не попали.
      </p>
    <% } %>

    <% if (discrepancies.length === 0) { %>
      <% if (summary.enteredCount < summary.lineCount) { %>
        <p class="inventory-act__empty">
          Пока расхождений не видно, но проверка не завершена: заполните факт по всем строкам.
        </p>
      <% } else { %>
        <p class="inventory-act__empty">
          Расхождений нет: фактические количества совпадают с учётными.
        </p>
      <% } %>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead class="table__head">
            <tr>
              <th class="table__heading" scope="col">SKU</th>
              <th class="table__heading" scope="col">Позиция</th>
              <th class="table__heading table__cell--num" scope="col">Учёт</th>
              <th class="table__heading table__cell--num" scope="col">Факт</th>
              <th class="table__heading table__cell--num" scope="col">Разница</th>
              <th class="table__heading" scope="col">Комментарий</th>
            </tr>
          </thead>
          <tbody>
            <% for (const line of discrepancies) { %>
              <tr class="table__row">
                <td class="table__cell table__cell--code"><%= line.sku %></td>
                <td class="table__cell"><%= line.name %></td>
                <td class="table__cell table__cell--num"><%= formatQty(line.expectedQty) %></td>
                <td class="table__cell table__cell--num"><%= formatQty(line.actualQty) %></td>
                <td class="table__cell table__cell--num">
                  <span class="inventory-diff <%= differenceClass(line.difference) %>">
                    <%= differenceLabel(line.difference) %>
                  </span>
                </td>
                <td class="table__cell"><%= line.comment ?? '—' %></td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>

    <div class="inventory-act__signatures">
      <div class="inventory-act__signature">
        <span class="inventory-act__signature-label">Кладовщик</span>
        <span class="inventory-act__signature-line"><%= count.startedByName ?? '—' %></span>
      </div>
      <div class="inventory-act__signature">
        <span class="inventory-act__signature-label">Администратор</span>
        <span class="inventory-act__signature-line"><%= count.approvedByName ?? '—' %></span>
      </div>
      <div class="inventory-act__signature">
        <span class="inventory-act__signature-label">Дата</span>
        <span class="inventory-act__signature-line">
          <%= count.approvedAt ? formatDateTime(count.approvedAt) : '—' %>
        </span>
      </div>
    </div>
  </section>
</section>

<script type="module" src="/js/inventory-form.js"></script>
