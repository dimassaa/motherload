<section aria-labelledby="users-title">
  <div class="page-header">
    <h1 id="users-title" class="page-header__title">Пользователи</h1>
    <a class="btn btn--primary" href="/admin/users/new">Добавить пользователя</a>
  </div>

  <p class="page-header__meta">Всего учётных записей: <%= users.length %></p>

  <% if (users.length === 0) { %>
    <%- include('../../../partials/empty-state', {
      title: 'Пока нет пользователей',
      text: 'Создайте первую учётную запись, чтобы сотрудник мог войти в систему.',
      actionHref: '/admin/users/new',
      actionLabel: 'Добавить пользователя',
    }) %>
  <% } else { %>
    <div class="table-wrap">
      <table class="table">
        <thead class="table__head">
          <tr>
            <th class="table__heading" scope="col">Имя</th>
            <th class="table__heading" scope="col">Email</th>
            <th class="table__heading" scope="col">Роль</th>
            <th class="table__heading" scope="col">Телефон</th>
            <th class="table__heading" scope="col">Статус</th>
            <th class="table__heading" scope="col">Последний вход</th>
            <th class="table__heading" scope="col"><span class="visually-hidden">Действия</span></th>
          </tr>
        </thead>
        <tbody>
          <% for (const user of users) { %>
            <tr class="table__row">
              <td class="table__cell">
                <a href="/admin/users/<%= user.id %>"><%= user.fullName %></a>
                <% if (user.id === currentUser.id) { %>
                  <span class="tag tag--plain">это вы</span>
                <% } %>
              </td>
              <td class="table__cell table__cell--code"><%= user.email %></td>
              <td class="table__cell"><%= roleLabel(user.role) %></td>
              <td class="table__cell table__cell--code"><%= user.phone ?? '—' %></td>
              <td class="table__cell">
                <%- include('../../../partials/status-chip', {
                  status: user.isActive ? 'active' : 'inactive',
                }) %>
              </td>
              <td class="table__cell">
                <% if (user.lastLoginAt) { %>
                  <%= formatDateTime(user.lastLoginAt) %>
                <% } else { %>
                  <span class="table__cell--muted">Ещё не входил</span>
                <% } %>
              </td>
              <td class="table__cell">
                <a href="/admin/users/<%= user.id %>">Изменить</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</section>
