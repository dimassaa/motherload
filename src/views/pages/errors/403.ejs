<%
  const backHref = typeof currentUser !== 'undefined' && currentUser ? '/dashboard' : '/';
  const backLabel = backHref === '/dashboard' ? 'Вернуться на обзор' : 'На главную';
%>
<section class="error-page" aria-labelledby="error-title">
  <p class="axis-label">
    <span>[ Ошибка 403 ]</span>
    <span>[ Доступ ]</span>
  </p>

  <h1 id="error-title" class="error-page__title">Доступ запрещён</h1>
  <p class="error-page__text">
    У вашей роли нет прав на этот раздел. Если доступ нужен по работе, попросите администратора
    выдать его.
  </p>

  <% if (typeof errorMessage === 'string' && errorMessage) { %>
    <p class="error-page__detail"><%= errorMessage %></p>
  <% } %>

  <a class="btn btn--outline" href="<%= backHref %>"><%= backLabel %></a>
</section>
