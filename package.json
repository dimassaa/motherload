{
  "name": "motherload",
  "version": "1.0.0",
  "private": true,
  "description": "Warehouse terminal for analysing and monitoring computer parts inventory",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node src/db/seed.js",
    "db:reset": "node scripts/reset-db.js",
    "alerts": "node scripts/recalc-alerts.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --test --test-concurrency=4 test/unit",
    "test:integration": "cross-env NODE_ENV=test node --test --test-concurrency=1 test/integration",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "cert": "node scripts/gen-cert.js",
    "smoke": "bash scripts/smoke.sh",
    "postinstall": "node scripts/copy-vendor.js",
    "build:og": "node scripts/build-og.js"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5",
    "@fontsource-variable/jetbrains-mono": "^5",
    "argon2": "^0.44",
    "chart.js": "^4",
    "connect-pg-simple": "^10",
    "decimal.js": "^10",
    "dotenv": "^17",
    "ejs": "^3",
    "express": "^5",
    "express-ejs-layouts": "^2",
    "express-rate-limit": "^8",
    "express-session": "^1",
    "helmet": "^8",
    "pg": "^8",
    "pino": "^9",
    "pino-http": "^10",
    "selfsigned": "^3",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "cross-env": "^10",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "globals": "^16",
    "prettier": "^3",
    "sharp": "^0.34",
    "supertest": "^7"
  }
}
