NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://motherload:motherload@localhost:5432/motherload
TEST_DATABASE_URL=postgres://motherload:motherload@localhost:5432/motherload_test
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=8
APP_URL=http://localhost:3000
HTTPS=0
# Direct Docker port publishing has no reverse proxy: keep false.
# Behind a proxy set the hop count (e.g. 1) or 'loopback'.
TRUST_PROXY=false
TLS_CERT_PATH=
TLS_KEY_PATH=
# The Docker entrypoint seeds demo data while the database holds no components.
# Set false for a real deployment.
SEED_DEMO=true
LOG_LEVEL=info
TZ=Europe/Minsk
# Demo/test "today" for analytics and alerts. Leave empty in production so the
# real Europe/Minsk calendar day is used.
ANALYTICS_REFERENCE_DATE=2026-11-22
