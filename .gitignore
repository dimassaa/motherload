node_modules/
.env
.env.*
!.env.example
coverage/
backups/
*.log
.DS_Store
tmp/
public/uploads/
.cache/
certs/
# Vendor output is generated, except the esbuild Chart.js ESM bundle: committing
# it keeps production installs (and the Docker runtime) independent of devDeps.
public/vendor/*
!public/vendor/chart.esm.js
# Fonts copied from node_modules by scripts/copy-vendor.js are reproducible.
# The NBRB BYN sign font is a committed source asset, hence the re-include.
public/fonts/*.woff2
!public/fonts/nbrb.woff2
